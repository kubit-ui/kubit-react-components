# PNPM Configuration for Kubit React Components (Vercel Compatible)
# https://pnpm.io/npmrc

# === Core Configuration ===
# Use hoisted node_modules structure (better compatibility with CI/CD)
shamefully-hoist=true

# === Dependency Resolution ===
# Automatically install peer dependencies
auto-install-peers=true

# Don't fail on peer dependency conflicts
strict-peer-dependencies=false

# === Lockfile ===
# Allow lockfile updates (useful for development)
frozen-lockfile=false

# === Publishing ===
access=public
