{
  "name": "@kubit-ui-web/react-components",
  "version": "2.0.0-beta.23",
  "description": "Kubit React Components is a customizable, accessible library of React web components, designed to enhance your application's user experience",
  "author": {
    "name": "Kubit",
    "email": "kubit@opendigitalservices.com",
    "url": "https://www.kubit-ui.com/",
    "organization": "Kubit",
    "organizationUrl": "https://www.kubit-ui.com/",
    "role": "Developer",
    "roleUrl": "https://www.kubit-ui.com/",
    "social": {
      "twitter": "https://twitter.com/kubit_ui",
      "github": "https://github.com/kubit-ui/kubit-react-components"
    }
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubit-ui/kubit-react-components.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@10.28.0",
  "keywords": [
    "react",
    "storybook",
    "typescript",
    "kubit",
    "kubit-ui",
    "kubit-react",
    "kubit-components"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.less",
    "*.sass",
    "*.styl",
    "*.svg",
    "*.ttf",
    "*.otf",
    "*.eot",
    "*.png",
    "*.jpg",
    "*.gif",
    "*.webp",
    "*.bmp",
    "*.ico"
  ],
  "files": [
    "dist/cjs",
    "dist/esm",
    "dist/types",
    "dist/styles",
    "package.json",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md",
    "!dist/cjs/lib/designSystem/**/css/*.css",
    "!dist/esm/lib/designSystem/**/css/*.css",
    "!dist/**/*.test.*",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.stories.*",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__",
    "!dist/**/tests",
    "!dist/**/storybook",
    "!dist/**/lib/storybook",
    "!dist/cjs/lib/storybook",
    "!dist/esm/lib/storybook",
    "!dist/types/lib/storybook",
    "!dist/**/.storybook",
    "!dist/esm/.storybook",
    "!dist/cjs/.storybook",
    "!dist/**/assets",
    "!dist/esm/assets",
    "!dist/cjs/assets",
    "!dist/**/scripts",
    "!dist/esm/scripts",
    "!dist/cjs/scripts",
    "!dist/**/node_modules",
    "!dist/**/.tsbuildinfo",
    "!dist/**/*.map",
    "!dist/**/.DS_Store"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./components/*": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/components/*/index.js",
      "require": "./dist/cjs/components/*/index.js"
    },
    "./styles/default/default.css": "./dist/styles/default/default.css",
    "./styles/default/default.min.css": "./dist/styles/default/default.min.css"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/esm/index.d.ts"
      ],
      "dist/*": [
        "dist/esm/index.d.ts"
      ]
    }
  },
  "scripts": {
    "start": "pnpm storybook",
    "storybook": "storybook dev -c .storybook -p 6006",
    "build": "pnpm dist && pnpm build-storybook",
    "prebuild-storybook": "pnpm generate-css",
    "build-storybook": "storybook build -c .storybook -o bundle --disable-telemetry",
    "generate-css": "bernova --config bernova.config.json",
    "generate:bundle-sizes": "node public/scripts/generate-bundle-sizes.mjs",
    "postdist": "pnpm generate:bundle-sizes",
    "dev": "vite",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "predist": "rm -rf dist",
    "dist": "vite build",
    "test": "pnpm lint && pnpm typecheck && vitest --coverage.enabled=true --silent --run",
    "test:ci": "vitest --ui --coverage.enabled=true",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage.enabled=true --run",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm dist",
    "publish-figma": "npx figma connect publish",
    "pack:check": "pnpm pack --dry-run",
    "pack:size": "pnpm pack --dry-run 2>&1 | tail -1",
    "pack:analyze": "pnpm pack && tar -tzf *.tgz | head -50 && rm *.tgz",
    "prepublishOnly": "pnpm dist && pnpm pack:size",
    "clean": "rm -rf dist node_modules .pnpm-store",
    "postinstall": "echo 'postinstall'"
  },
  "peerDependencies": {
    "react": ">=17.0.0 || >=18.3.1",
    "react-dom": ">=17.0.0 || >=18.3.1"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.3.12",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-coverage": "^3.0.0",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-links": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "bernova": "1.0.0",
    "cssnano": "^7.1.2",
    "eslint": "^9.39.2",
    "eslint-config-kubit": "1.2.0",
    "eslint-plugin-storybook": "10.1.11",
    "glob": "^13.0.0",
    "html-validate": "^10.5.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "^10.1.11",
    "storybook-addon-deep-controls": "^0.10.0",
    "storybook-addon-pseudo-states": "^10.1.11",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.16",
    "vitest-axe": "^0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/kubit-ui/kubit-react-components/issues"
  },
  "homepage": "https://www.kubit-ui.com/"
}
