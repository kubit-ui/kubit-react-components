{
  "name": "@kubit-ui-web/monorepo",
  "version": "2.0.0-beta.43",
  "description": "Kubit UI Monorepo - React components and design system",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubit-ui/kubit-react-components.git",
    "directory": "."
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "turbo run dev --filter=@kubit-ui-web/storybook",
    "dev:components": "turbo run dev --filter=@kubit-ui-web/react-components",
    "dev:design-system": "turbo run dev --filter=@kubit-ui-web/design-system",
    "build": "turbo run build --filter=!@kubit-ui-web/storybook",
    "build:components": "turbo run build --filter=@kubit-ui-web/react-components",
    "build:design-system": "turbo run build --filter=@kubit-ui-web/design-system",
    "build:storybook": "turbo run build --filter=@kubit-ui-web/storybook",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "test": "turbo run test --filter=@kubit-ui-web/react-components",
    "test:watch": "turbo run test:watch --filter=@kubit-ui-web/react-components",
    "test:coverage": "turbo run test:coverage --filter=@kubit-ui-web/react-components",
    "typecheck": "turbo run typecheck",
    "validate": "turbo run format:check lint typecheck build --filter=!@kubit-ui-web/storybook",
    "validate:quick": "turbo run lint typecheck",
    "clean": "turbo run clean && rm -rf node_modules .pnpm-store",
    "clean:build": "turbo run clean:build"
  },
  "devDependencies": {
    "turbo": "^2.7.5"
  },
  "bugs": {
    "url": "https://github.com/kubit-ui/kubit-react-components/issues",
    "email": "kubit.lab.dev@gmail.com"
  },
  "homepage": "https://www.kubit-ui.com/",
  "documentation": "https://www.kubit-ui.com"
}
