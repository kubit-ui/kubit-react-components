{
  "name": "@kubit-ui-web/monorepo",
  "version": "2.0.0-beta.43",
  "description": "Kubit UI Monorepo - React components and design system",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubit-ui/kubit-react-components.git",
    "directory": "."
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm --filter @kubit-ui-web/storybook dev",
    "dev:components": "pnpm --filter @kubit-ui-web/react-components dev",
    "dev:design-system": "pnpm --filter @kubit-ui-web/design-system dev",
    "build": "pnpm -r --filter=!@kubit-ui-web/storybook build",
    "build:components": "pnpm --filter @kubit-ui-web/react-components build",
    "build:design-system": "pnpm --filter @kubit-ui-web/design-system build",
    "build:storybook": "pnpm --filter @kubit-ui-web/storybook build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "test": "pnpm --filter @kubit-ui-web/react-components test",
    "test:watch": "pnpm --filter @kubit-ui-web/react-components test:watch",
    "test:coverage": "pnpm --filter @kubit-ui-web/react-components test:coverage",
    "typecheck": "pnpm -r typecheck",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "validate:quick": "pnpm lint && pnpm typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules .pnpm-store",
    "clean:build": "pnpm -r clean:build",
    "publish:components": "pnpm --filter @kubit-ui-web/react-components publish",
    "publish:design-system": "pnpm --filter @kubit-ui-web/design-system publish",
    "publish:all": "pnpm -r --filter=!@kubit-ui-web/storybook publish",
    "version:components": "pnpm --filter @kubit-ui-web/react-components version",
    "version:design-system": "pnpm --filter @kubit-ui-web/design-system version",
    "chromatic": "pnpm --filter @kubit-ui-web/storybook chromatic"
  },
  "devDependencies": {},
  "bugs": {
    "url": "https://github.com/kubit-ui/kubit-react-components/issues",
    "email": "kubit.lab.dev@gmail.com"
  },
  "homepage": "https://www.kubit-ui.com/",
  "documentation": "https://www.kubit-ui.com"
}
