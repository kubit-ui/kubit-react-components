{
  "name": "@kubit-ui-web/react-components",
  "version": "2.0.0-beta.44",
  "description": "Kubit React Components is a customizable, accessible library of React web components, designed to enhance your application's user experience",
  "author": {
    "name": "Kubit",
    "email": "kubit@opendigitalservices.com",
    "url": "https://www.kubit-ui.com/",
    "organization": "Kubit",
    "organizationUrl": "https://www.kubit-ui.com/",
    "role": "Developer",
    "roleUrl": "https://www.kubit-ui.com/",
    "social": {
      "twitter": "https://twitter.com/kubit_ui",
      "github": "https://github.com/kubit-ui/kubit-react-components"
    }
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubit-ui/kubit-react-components.git",
    "directory": "."
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "overrides": {
      "eslint-plugin-react-hooks": "7.1.0-canary-272441a9-20260209",
      "zod-validation-error": "^3.4.0"
    }
  },
  "scripts": {
    "dev": "turbo run dev --filter=@kubit-ui-web/storybook",
    "dev:components": "turbo run dev --filter=@kubit-ui-web/react-components",
    "dev:design-system": "turbo run dev --filter=@kubit-ui-web/design-system",
    "build": "turbo run build --filter=!@kubit-ui-web/storybook",
    "build:all": "turbo run build",
    "build:components": "turbo run build --filter=@kubit-ui-web/react-components...",
    "build:design-system": "turbo run build --filter=@kubit-ui-web/design-system...",
    "build:storybook": "turbo run build --filter=@kubit-ui-web/storybook",
    "build:force": "turbo run build --force --filter=!@kubit-ui-web/storybook",
    "lint": "turbo run lint --continue",
    "lint:components": "turbo run lint --filter=@kubit-ui-web/react-components",
    "lint:design-system": "turbo run lint --filter=@kubit-ui-web/design-system",
    "lint:fix": "turbo run lint:fix --continue",
    "format": "turbo run format --continue",
    "format:check": "turbo run format:check --continue",
    "test": "turbo run test --filter=@kubit-ui-web/react-components",
    "test:watch": "turbo run test:watch --filter=@kubit-ui-web/react-components",
    "test:coverage": "turbo run test:coverage --filter=@kubit-ui-web/react-components",
    "typecheck": "turbo run typecheck --continue",
    "typecheck:components": "turbo run typecheck --filter=@kubit-ui-web/react-components",
    "typecheck:design-system": "turbo run typecheck --filter=@kubit-ui-web/design-system",
    "typecheck:storybook": "turbo run typecheck --filter=@kubit-ui-web/storybook",
    "validate": "turbo run format:check lint typecheck build --filter=!@kubit-ui-web/storybook --continue",
    "validate:quick": "turbo run lint typecheck --continue",
    "validate:ci": "turbo run format:check lint typecheck test build --filter=!@kubit-ui-web/storybook --continue",
    "clean": "turbo run clean && rm -rf node_modules .pnpm-store",
    "clean:build": "turbo run clean:build",
    "clean:cache": "turbo daemon clean && rm -rf .turbo",
    "turbo:daemon": "turbo daemon",
    "turbo:daemon:stop": "turbo daemon stop",
    "turbo:daemon:restart": "turbo daemon restart",
    "turbo:prune": "turbo prune",
    "graph": "turbo run build --graph=dependency-graph.html",
    "graph:dot": "turbo run build --graph=dependency-graph.dot",
    "update-deps": "npx npm-check-updates",
    "update-deps:apply": "npx npm-check-updates -u",
    "update-deps:components": "pnpm --filter=@kubit-ui-web/react-components exec npx npm-check-updates",
    "update-deps:components:apply": "pnpm --filter=@kubit-ui-web/react-components exec npx npm-check-updates -u",
    "update-deps:design-system": "pnpm --filter=@kubit-ui-web/design-system exec npx npm-check-updates",
    "update-deps:design-system:apply": "pnpm --filter=@kubit-ui-web/design-system exec npx npm-check-updates -u",
    "update-deps:storybook": "pnpm --filter=@kubit-ui-web/storybook exec npx npm-check-updates",
    "update-deps:storybook:apply": "pnpm --filter=@kubit-ui-web/storybook exec npx npm-check-updates -u",
    "update-deps:all": "pnpm update-deps && pnpm update-deps:components && pnpm update-deps:design-system && pnpm update-deps:storybook",
    "update-deps:all:apply": "pnpm update-deps:apply && pnpm update-deps:components:apply && pnpm update-deps:design-system:apply && pnpm update-deps:storybook:apply",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish",
    "changeset:status": "changeset status --verbose"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "turbo": "^2.8.7"
  },
  "bugs": {
    "url": "https://github.com/kubit-ui/kubit-react-components/issues",
    "email": "kubit.lab.dev@gmail.com"
  },
  "homepage": "https://www.kubit-ui.com/",
  "documentation": "https://www.kubit-ui.com"
}
