# Git files
.git/
.github/
.gitignore

# CI/CD
.gitlab-ci.yml
.travis.yml

# Documentation (keep only essential)
CONTRIBUTING.md

# Build artifacts not needed
dist/**/.storybook
dist/**/assets
dist/**/scripts
