{
  "name": "@kubit-ui-web/design-system",
  "version": "2.0.0-beta.26",
  "description": "Kubit Design System - CSS-in-JS styles and themes for Kubit components, powered by Bernova",
  "author": {
    "name": "Kubit",
    "email": "kubit@opendigitalservices.com",
    "url": "https://www.kubit-ui.com/",
    "organization": "Kubit",
    "organizationUrl": "https://www.kubit-ui.com/",
    "role": "Developer",
    "roleUrl": "https://www.kubit-ui.com/",
    "social": {
      "twitter": "https://twitter.com/kubit_ui",
      "github": "https://github.com/kubit-ui/kubit-react-components"
    }
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubit-ui/kubit-react-components.git",
    "directory": "packages/design-system"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "22.x"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/kubit-ui"
  },
  "contributors": [
    {
      "name": "Kubit Community",
      "url": "https://github.com/kubit-ui/kubit-react-components/graphs/contributors"
    }
  ],
  "packageManager": "pnpm@10.30.2",
  "keywords": [
    "design-system",
    "css-in-js",
    "themes",
    "styles",
    "design-tokens",
    "bernova",
    "kubit",
    "kubit-ui",
    "typescript",
    "css",
    "styling",
    "theming",
    "customizable"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist/cjs",
    "dist/esm",
    "dist/types",
    "dist/styles",
    "package.json",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/**/*.test.d.ts",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./provider": {
      "types": "./dist/types/provider/index.d.ts",
      "import": "./dist/esm/provider/index.js",
      "require": "./dist/cjs/provider/index.js"
    },
    "./provider/Provider": {
      "types": "./dist/types/provider/provider.d.ts",
      "import": "./dist/esm/provider/provider.js",
      "require": "./dist/cjs/provider/provider.js"
    },
    "./styles/*": {
      "import": "./dist/styles/*.css",
      "require": "./dist/styles/*.css"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kubit-design-system": "./dist/cjs/cli.js"
  },
  "scripts": {
    "dev": "rslib build --watch",
    "build": "rm -rf dist && pnpm generate-css && rslib build",
    "predist": "rm -rf dist",
    "dist": "pnpm generate-css && rslib build",
    "generate-css": "TS_NODE_TRANSPILE_ONLY=true TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' npx bv-build --embed-css",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm dist",
    "validate:quick": "pnpm lint && pnpm typecheck",
    "pack:check": "pnpm pack --dry-run",
    "pack:size": "pnpm pack --dry-run 2>&1 | tail -1",
    "pack:analyze": "pnpm pack && tar -tzf *.tgz | head -50 && rm *.tgz",
    "pack:verify": "pnpm pack:check && pnpm pack:size",
    "clean": "rm -rf dist node_modules",
    "clean:build": "rm -rf dist",
    "prepublishOnly": "pnpm dist && pnpm pack:size",
    "prerelease": "pnpm validate",
    "bernova:no-check": "TS_NODE_TRANSPILE_ONLY=true npx bernova"
  },
  "peerDependencies": {
    "@kubit-ui-web/react-components": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@kubit-ui-web/react-components": {
      "optional": true
    }
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.3.1",
    "bernova": "1.6.0",
    "cssnano": "^7.1.2",
    "eslint": "^10.0.2",
    "eslint-config-kubit": "2.0.2",
    "glob": "^13.0.6",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "@rslib/core": "^0.19.6"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/kubit-ui/kubit-react-components/issues",
    "email": "kubit.lab.dev@gmail.com"
  },
  "homepage": "https://www.kubit-ui.com/",
  "documentation": "https://www.kubit-ui.com"
}
