{
  "name": "@kubit-ui-web/design-system",
  "version": "2.0.0-beta.32",
  "description": "Kubit Design System - CSS-in-JS styles and themes for Kubit components, powered by Bernova",
  "author": {
    "name": "Kubit",
    "email": "kubit@opendigitalservices.com",
    "url": "https://www.kubit-ui.com/",
    "organization": "Kubit",
    "organizationUrl": "https://www.kubit-ui.com/",
    "role": "Developer",
    "roleUrl": "https://www.kubit-ui.com/",
    "social": {
      "twitter": "https://twitter.com/kubit_ui",
      "github": "https://github.com/kubit-ui/kubit-react-components"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubit-ui/kubit-react-components.git",
    "directory": "packages/design-system"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": "22.x"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/kubit-ui"
  },
  "contributors": [
    {
      "name": "Kubit Community",
      "url": "https://github.com/kubit-ui/kubit-react-components/graphs/contributors"
    }
  ],
  "packageManager": "yarn@4.9.1",
  "keywords": [
    "design-system",
    "css-in-js",
    "themes",
    "styles",
    "design-tokens",
    "bernova",
    "kubit",
    "kubit-ui",
    "typescript",
    "css",
    "styling",
    "theming",
    "customizable"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist/cjs",
    "dist/esm",
    "dist/types",
    "dist/styles",
    "package.json",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md",
    "!dist/**/*.test.*",
    "!dist/**/*.test.d.ts",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./provider": {
      "types": "./dist/types/provider/index.d.ts",
      "import": "./dist/esm/provider/index.js",
      "require": "./dist/cjs/provider/index.js"
    },
    "./provider/Provider": {
      "types": "./dist/types/provider/provider.d.ts",
      "import": "./dist/esm/provider/provider.js",
      "require": "./dist/cjs/provider/provider.js"
    },
    "./styles/*": {
      "import": "./dist/styles/*.css",
      "require": "./dist/styles/*.css"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kubit-design-system": "./dist/cjs/cli.js"
  },
  "scripts": {
    "dev": "rslib build --watch",
    "build": "rm -rf dist && yarn generate-css && rslib build",
    "predist": "rm -rf dist",
    "dist": "yarn generate-css && rslib build",
    "generate-css": "TS_NODE_TRANSPILE_ONLY=true TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' yarn exec bv-build --embed-css",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "typecheck": "tsc --noEmit",
    "validate": "yarn format:check && yarn lint && yarn typecheck && yarn dist",
    "validate:quick": "yarn lint && yarn typecheck",
    "pack:check": "yarn pack --dry-run",
    "pack:size": "yarn pack --dry-run 2>&1 | tail -1",
    "pack:analyze": "yarn pack && tar -tzf *.tgz | head -50 && rm *.tgz",
    "pack:verify": "yarn pack:check && yarn pack:size",
    "clean": "rm -rf dist node_modules",
    "clean:build": "rm -rf dist",
    "prepublishOnly": "yarn dist && yarn pack:size",
    "prerelease": "yarn validate",
    "bernova:no-check": "TS_NODE_TRANSPILE_ONLY=true yarn exec bernova"
  },
  "peerDependencies": {
    "@kubit-ui-web/react-components": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@kubit-ui-web/react-components": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kubit-ui-web/eslint-plugin-kubit": "^0.0.5",
    "@rslib/core": "^0.19.6",
    "@types/node": "^25.3.3",
    "bernova": "1.6.0",
    "cssnano": "^7.1.2",
    "glob": "^13.0.6",
    "oxfmt": "^0.39.0",
    "oxlint": "^1.54.0",
    "postcss": "^8.5.8",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/kubit-ui/kubit-react-components/issues",
    "email": "kubit.lab.dev@gmail.com"
  },
  "homepage": "https://www.kubit-ui.com/",
  "documentation": "https://www.kubit-ui.com"
}
