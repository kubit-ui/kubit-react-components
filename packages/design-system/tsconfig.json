{
  "exclude": [
    "src/**/__mocks__",
    "src/**/__fixtures__",
    "src/**/__stories__",
    "src/**/stories",
    "dist",
    "rslib.config.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "sourceMap": false,
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["DOM", "ES2020", "ES2021"],
    "declaration": false,
    "declarationMap": false,
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "preserveSymlinks": false,
    "jsx": "react-jsx",
    "composite": false,
    "types": ["node"],
    "typeRoots": ["src/lib/types", "node_modules/@types", "../../node_modules/@types", "node_modules", "../../node_modules"],
    "removeComments": false,
    "erasableSyntaxOnly": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@kubit-ui-web/react-components": ["../components/src"],
      "@kubit-ui-web/react-components/*": ["../components/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "app/src/types/global.d.ts"
  ],
  "references": [{ "path": "../components" }]
}
