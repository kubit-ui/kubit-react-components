{
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["DOM", "ES2020", "ES2021"],
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/stories": ["./stories"],
      "@/stories/*": ["./stories/*"]
    }
  },
  "include": [".storybook/**/*", "stories/**/*", "overview/**/*"],
  "exclude": ["node_modules", "dist", ".storybook-cache"]
}
