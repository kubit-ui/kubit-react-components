{
  "exclude": [
    "src/**/*.test.*",
    "src/**/__mocks__",
    "src/**/__tests__",
    "src/**/*.mock.*",
    "dist",
    "vitest.config.ts",
    "vitest.setup.ts",
    "vite.config.mts"
  ],
  "compilerOptions": {
    "target": "es2020",
    "lib": ["ES2015", "ES2016", "ES2021", "DOM"],
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "module": "ESNext",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "fixtures/*": ["./__fixtures__/*"]
    },
    "typeRoots": ["src/types", "node_modules/@types"],
    "types": ["jest"],
    "resolveJsonModule": true,
    "checkJs": false,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "plugins": [],
    "skipLibCheck": true
  }
}
