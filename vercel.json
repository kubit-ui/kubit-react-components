{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "kubit-storybook",
  "public": true,
  "github": {
    "enabled": true,
    "autoAlias": true
  },
  "buildCommand": "corepack yarn build:storybook",
  "devCommand": "corepack yarn dev",
  "installCommand": "corepack yarn install --immutable",
  "framework": null,
  "outputDirectory": "packages/storybook/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sb-addons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sb-manager/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
